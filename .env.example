# Public URL used for canonical links, Open Graph & sitemap
NEXT_PUBLIC_SITE_URL=https://beyond-the-frame-indol.vercel.app

# Enquiry delivery — configure one or both
# 1) Email via Resend (https://resend.com)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=hello@yourstudio.com
ENQUIRY_FROM_EMAIL="Studio Website <enquiries@yourstudio.com>"
# 2) Webhook (Zapier, Make, Slack, HubSpot, Airtable…) — receives JSON
ENQUIRY_WEBHOOK_URL=
